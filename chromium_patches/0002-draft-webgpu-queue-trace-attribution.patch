+
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_VIEWER_WEBGPU_EXPERIMENT_SWITCHES_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_VIEWER_WEBGPU_EXPERIMENT_SWITCHES_H_
+
+#include "base/command_line.h"
+
+namespace blink::webgpu_viewer_experiments {
+
+inline constexpr char kViewerAppUrlSwitch[] = "viewer-app-url";
+inline constexpr char kViewerTrustedContentSwitch[] = "viewer-trusted-content";
+inline constexpr char kViewerSkipWebGPUResourceLabelsSwitch[] =
+    "viewer-skip-webgpu-resource-labels";
+inline constexpr char kViewerSkipWebGPUCommandLabelsSwitch[] =
+    "viewer-skip-webgpu-command-labels";
+inline constexpr char kViewerSkipWebGPUShaderSourceNullCheckSwitch[] =
+    "viewer-skip-webgpu-shader-source-null-check";
+inline constexpr char kViewerSkipWebGPUShaderMemoryAccountingSwitch[] =
+    "viewer-skip-webgpu-shader-memory-accounting";
+inline constexpr char kViewerSkipWebGPURedundantPipelineSetsSwitch[] =
+    "viewer-skip-webgpu-redundant-pipeline-sets";
+inline constexpr char kViewerSkipWebGPURedundantBindGroupSetsSwitch[] =
+    "viewer-skip-webgpu-redundant-bind-group-sets";
+inline constexpr char kViewerSkipWebGPURedundantBufferSetsSwitch[] =
+    "viewer-skip-webgpu-redundant-buffer-sets";
+inline constexpr char kViewerSkipWebGPURedundantRenderStateSetsSwitch[] =
+    "viewer-skip-webgpu-redundant-render-state-sets";
+inline constexpr char kViewerSkipWebGPUUseCountersSwitch[] =
+    "viewer-skip-webgpu-use-counters";
+
+struct ViewerWebGPUResourceExperimentState {
+  bool skip_resource_labels = false;
+  bool skip_command_labels = false;
+  bool skip_shader_source_null_check = false;
+  bool skip_shader_memory_accounting = false;
+  bool skip_redundant_pipeline_sets = false;
+  bool skip_redundant_bind_group_sets = false;
+  bool skip_redundant_buffer_sets = false;
+  bool skip_redundant_render_state_sets = false;
+  bool skip_use_counters = false;
+};
+
+inline bool IsTrustedViewerApp(const base::CommandLine* command_line) {
+  return command_line && command_line->HasSwitch(kViewerAppUrlSwitch) &&
+         command_line->HasSwitch(kViewerTrustedContentSwitch);
+}
+
+inline ViewerWebGPUResourceExperimentState
+BuildViewerWebGPUResourceExperimentState() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!IsTrustedViewerApp(command_line)) {
+    return {};
+  }
+  ViewerWebGPUResourceExperimentState state;
+  state.skip_resource_labels =
+      command_line->HasSwitch(kViewerSkipWebGPUResourceLabelsSwitch);
+  state.skip_command_labels =
+      command_line->HasSwitch(kViewerSkipWebGPUCommandLabelsSwitch);
+  state.skip_shader_source_null_check = command_line->HasSwitch(
+      kViewerSkipWebGPUShaderSourceNullCheckSwitch);
+  state.skip_shader_memory_accounting = command_line->HasSwitch(
+      kViewerSkipWebGPUShaderMemoryAccountingSwitch);
+  state.skip_redundant_pipeline_sets =
+      command_line->HasSwitch(kViewerSkipWebGPURedundantPipelineSetsSwitch);
+  state.skip_redundant_bind_group_sets = command_line->HasSwitch(
+      kViewerSkipWebGPURedundantBindGroupSetsSwitch);
+  state.skip_redundant_buffer_sets = command_line->HasSwitch(
+      kViewerSkipWebGPURedundantBufferSetsSwitch);
+  state.skip_redundant_render_state_sets = command_line->HasSwitch(
+      kViewerSkipWebGPURedundantRenderStateSetsSwitch);
+  state.skip_use_counters =
+      command_line->HasSwitch(kViewerSkipWebGPUUseCountersSwitch);
+  return state;
+}
+
+inline const ViewerWebGPUResourceExperimentState&
+GetViewerWebGPUResourceExperimentState() {
+  static const ViewerWebGPUResourceExperimentState state =
+      BuildViewerWebGPUResourceExperimentState();
+  return state;
+}
+
+inline bool ShouldSkipResourceLabels() {
+  return GetViewerWebGPUResourceExperimentState().skip_resource_labels;
+}
+
+inline bool ShouldSkipCommandLabels() {
+  return GetViewerWebGPUResourceExperimentState().skip_command_labels;
+}
+
+inline bool ShouldSkipShaderSourceNullCheck() {
+  return GetViewerWebGPUResourceExperimentState()
+      .skip_shader_source_null_check;
+}
+
+inline bool ShouldSkipShaderMemoryAccounting() {
+  return GetViewerWebGPUResourceExperimentState()
+      .skip_shader_memory_accounting;
+}
+
+inline bool ShouldSkipRedundantPipelineSets() {
+  return GetViewerWebGPUResourceExperimentState()
+      .skip_redundant_pipeline_sets;
+}
+
+inline bool ShouldSkipRedundantBindGroupSets() {
+  return GetViewerWebGPUResourceExperimentState()
+      .skip_redundant_bind_group_sets;
+}
+
+inline bool ShouldSkipRedundantBufferSets() {
+  return GetViewerWebGPUResourceExperimentState().skip_redundant_buffer_sets;
+}
+
+inline bool ShouldSkipRedundantRenderStateSets() {
+  return GetViewerWebGPUResourceExperimentState()
+      .skip_redundant_render_state_sets;
+}
+
+inline bool ShouldSkipUseCounters() {
+  return GetViewerWebGPUResourceExperimentState().skip_use_counters;
+}
