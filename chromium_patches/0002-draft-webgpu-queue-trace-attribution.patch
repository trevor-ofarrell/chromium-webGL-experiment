+bool ConvertCommonOrigin2D(const V8GPUOrigin2D* in, wgpu::Origin2D* out) {
+  DCHECK(in);
+  DCHECK(out);
+
+  switch (in->GetContentType()) {
+    case V8GPUOrigin2D::ContentType::kGPUOrigin2DDict: {
+      const GPUOrigin2DDict* dict = in->GetAsGPUOrigin2DDict();
+      *out = {dict->x(), dict->y()};
+      return true;
+    }
+
+    case V8GPUOrigin2D::ContentType::kUnsignedLongEnforceRangeSequence: {
+      const Vector<uint32_t>& sequence =
+          in->GetAsUnsignedLongEnforceRangeSequence();
+      switch (sequence.size()) {
+        case 0:
+          *out = {0, 0};
+          return true;
+        case 1:
+          *out = {sequence[0], 0};
+          return true;
+        case 2:
+          *out = {sequence[0], sequence[1]};
+          return true;
+        default:
+          return false;
+      }
+    }
+  }
+
+  return false;
+}
+
+bool ComputeCommonWriteBufferRange(base::span<const uint8_t> data,
+                                   unsigned data_bytes_per_element,
+                                   uint64_t data_element_offset,
+                                   std::optional<uint64_t> data_element_count,
+                                   size_t* data_byte_offset,
+                                   size_t* write_byte_size) {
+  DCHECK_GT(data_bytes_per_element, 0u);
+  DCHECK(data_byte_offset);
+  DCHECK(write_byte_size);
+
+  if (data_element_offset != 0) {
+    return false;
+  }
+
+  if (!data_element_count.has_value()) {
+    if (data.size() % 4 != 0) {
+      return false;
+    }
+    *data_byte_offset = 0;
+    *write_byte_size = data.size();
+    return true;
+  }
+
+  const uint64_t element_count = data.size() / data_bytes_per_element;
+  const uint64_t write_element_count = data_element_count.value();
+  if (write_element_count > element_count) {
+    return false;
+  }
+
+  const size_t write_byte_size_value =
+      static_cast<size_t>(write_element_count) * data_bytes_per_element;
+  if (write_byte_size_value % 4 != 0) {
+    return false;
+  }
+
+  *data_byte_offset = 0;
+  *write_byte_size = write_byte_size_value;
+  return true;
+}
