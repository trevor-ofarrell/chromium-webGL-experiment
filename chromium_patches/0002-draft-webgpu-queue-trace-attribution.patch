+
+bool EstimateCommonWriteTextureBytesUpperBound(
+    const wgpu::TexelCopyBufferLayout& layout,
+    const wgpu::Extent3D& extent,
+    wgpu::TextureFormat format,
+    wgpu::TextureAspect aspect,
+    size_t* bytes_upper_bound) {
+  DCHECK(bytes_upper_bound);
+  if (aspect != wgpu::TextureAspect::All || extent.depthOrArrayLayers != 1 ||
+      extent.width == 0 || extent.height == 0) {
+    return false;
+  }
+
+  switch (format) {
+    case wgpu::TextureFormat::R32Float:
+    case wgpu::TextureFormat::R32Uint:
+    case wgpu::TextureFormat::R32Sint:
+    case wgpu::TextureFormat::RG16Uint:
+    case wgpu::TextureFormat::RG16Sint:
+    case wgpu::TextureFormat::RG16Float:
+    case wgpu::TextureFormat::RG16Snorm:
+    case wgpu::TextureFormat::RG16Unorm:
+    case wgpu::TextureFormat::RGBA8Unorm:
+    case wgpu::TextureFormat::RGBA8UnormSrgb:
+    case wgpu::TextureFormat::RGBA8Snorm:
+    case wgpu::TextureFormat::RGBA8Uint:
+    case wgpu::TextureFormat::RGBA8Sint:
+    case wgpu::TextureFormat::BGRA8Unorm:
+    case wgpu::TextureFormat::BGRA8UnormSrgb:
+    case wgpu::TextureFormat::RGB10A2Uint:
+    case wgpu::TextureFormat::RGB10A2Unorm:
+    case wgpu::TextureFormat::RG11B10Ufloat:
+    case wgpu::TextureFormat::RGB9E5Ufloat:
+      break;
+    default:
+      return false;
+  }
+
+  base::CheckedNumeric<size_t> row_bytes = extent.width;
+  row_bytes *= 4u;
+  if (!row_bytes.IsValid()) {
+    return false;
+  }
+  const size_t row_bytes_value = row_bytes.ValueOrDie();
+
+  if (layout.bytesPerRow == wgpu::kCopyStrideUndefined) {
+    if (extent.height > 1) {
+      return false;
+    }
+    *bytes_upper_bound = row_bytes_value;
+    return true;
+  }
+
+  if (layout.bytesPerRow < row_bytes_value) {
+    return false;
+  }
+
+  base::CheckedNumeric<size_t> required_bytes = layout.bytesPerRow;
+  required_bytes *= extent.height - 1;
+  required_bytes += row_bytes_value;
+  if (!required_bytes.IsValid()) {
+    return false;
+  }
+  *bytes_upper_bound = required_bytes.ValueOrDie();
+  return true;
+}
