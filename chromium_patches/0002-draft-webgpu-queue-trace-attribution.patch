+
+bool ConvertCommonExtent3D(const V8GPUExtent3D* in, wgpu::Extent3D* out) {
+  DCHECK(in);
+  DCHECK(out);
+
+  switch (in->GetContentType()) {
+    case V8GPUExtent3D::ContentType::kGPUExtent3DDict: {
+      const GPUExtent3DDict* dict = in->GetAsGPUExtent3DDict();
+      if (dict->hasDepth()) {
+        return false;
+      }
+      *out = {dict->width(), dict->height(), dict->depthOrArrayLayers()};
+      return true;
+    }
+
+    case V8GPUExtent3D::ContentType::kUnsignedLongEnforceRangeSequence: {
+      const Vector<uint32_t>& sequence =
+          in->GetAsUnsignedLongEnforceRangeSequence();
+      switch (sequence.size()) {
+        case 1:
+          *out = {sequence[0], 1, 1};
+          return true;
+        case 2:
+          *out = {sequence[0], sequence[1], 1};
+          return true;
+        case 3:
+          *out = {sequence[0], sequence[1], sequence[2]};
+          return true;
+        default:
+          return false;
+      }
+    }
+  }
+
+  return false;
+}
+
+wgpu::TextureViewDimension ResolveTextureBindingViewDimension(
+    GPUDevice* device,
+    wgpu::TextureDimension dimension,
+    uint32_t depth_or_array_layers,
+    wgpu::TextureViewDimension texture_binding_view_dimension) {
+  if (device->features()->Has(V8GPUFeatureName::Enum::kCoreFeaturesAndLimits)) {
+    return wgpu::TextureViewDimension::Undefined;
+  }
+
+  if (texture_binding_view_dimension != wgpu::TextureViewDimension::Undefined) {
+    return texture_binding_view_dimension;
+  }
+
+  switch (dimension) {
+    case wgpu::TextureDimension::e1D:
+      return wgpu::TextureViewDimension::e1D;
+    case wgpu::TextureDimension::e2D:
+      return depth_or_array_layers == 1 ? wgpu::TextureViewDimension::e2D
+                                        : wgpu::TextureViewDimension::e2DArray;
+    case wgpu::TextureDimension::e3D:
+      return wgpu::TextureViewDimension::e3D;
+    default:
+      return wgpu::TextureViewDimension::Undefined;
+  }
+}
+
+wgpu::TextureViewDimension GetTextureBindingViewDimensionFromChain(
+    const wgpu::ChainedStruct* next_in_chain) {
+  for (const wgpu::ChainedStruct* chain = next_in_chain; chain;
+       chain = chain->nextInChain) {
+    if (chain->sType == wgpu::SType::TextureBindingViewDimension) {
+      return static_cast<const wgpu::TextureBindingViewDimension*>(chain)
+          ->textureBindingViewDimension;
+    }
