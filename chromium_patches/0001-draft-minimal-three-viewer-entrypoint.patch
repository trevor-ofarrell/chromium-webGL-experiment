+base::FilePath NormalizeViewerFilePath(base::FilePath path) {
+  path = path.NormalizePathSeparators();
+  if (path.empty() || path.ReferencesParent())
+    return base::FilePath();
+
+  if (path.IsAbsolute())
+    return path;
+
+  base::FilePath current_dir;
+  if (!base::PathService::Get(base::DIR_CURRENT, &current_dir))
+    return base::FilePath();
+
+  return current_dir.Append(path).NormalizePathSeparators();
+}
+
+GURL ViewerFilePathToFileUrl(base::FilePath path) {
+  path = NormalizeViewerFilePath(std::move(path));
+  if (path.empty() || !path.IsAbsolute())
+    return GURL();
+  return net::FilePathToFileURL(path);
+}
+
+GURL GetViewerAppUrlFromCommandLine() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(switches::kViewerAppUrl))
+    return GURL();
+
+  const base::FilePath viewer_app_path =
+      command_line.GetSwitchValuePath(switches::kViewerAppUrl);
+  if (!viewer_app_path.empty() && viewer_app_path.IsAbsolute())
+    return ViewerFilePathToFileUrl(viewer_app_path);
+
+  const std::string viewer_app_url =
+      command_line.GetSwitchValueASCII(switches::kViewerAppUrl);
+  GURL url(viewer_app_url);
+  if (url.is_valid() && url.has_scheme())
+    return url;
+
+  return ViewerFilePathToFileUrl(viewer_app_path);
+}
+
+bool IsViewerFileNavigationAllowed(const GURL& viewer_app_url,
+                                   const GURL& navigation_url) {
+  if (!navigation_url.SchemeIsFile())
+    return false;
+
+  base::FilePath viewer_app_path;
+  base::FilePath navigation_path;
+  if (!net::FileURLToFilePath(viewer_app_url, &viewer_app_path) ||
+      !net::FileURLToFilePath(navigation_url, &navigation_path)) {
+    return false;
+  }
+
+  viewer_app_path = NormalizeViewerFilePath(std::move(viewer_app_path));
+  navigation_path = NormalizeViewerFilePath(std::move(navigation_path));
+  if (viewer_app_path.empty() || navigation_path.empty())
+    return false;
+
+  const base::FilePath viewer_app_dir = viewer_app_path.DirName();
+  return navigation_path == viewer_app_path ||
+         viewer_app_dir.IsParent(navigation_path);
+}
+
+bool IsViewerNavigationAllowed(const GURL& viewer_app_url,
+                               const GURL& navigation_url) {
+  if (!viewer_app_url.is_valid() || !navigation_url.is_valid())
+    return false;
+
+  if (navigation_url == GURL(url::kAboutBlankURL))
+    return true;
+
+  if (viewer_app_url.SchemeIsFile())
+    return IsViewerFileNavigationAllowed(viewer_app_url, navigation_url);
+
+  return url::Origin::Create(viewer_app_url)
+      .IsSameOriginWith(url::Origin::Create(navigation_url));
+}
+
+class ViewerNavigationThrottle : public NavigationThrottle {
+ public:
+  explicit ViewerNavigationThrottle(NavigationThrottleRegistry& registry)
+      : NavigationThrottle(registry) {}
+
+  ThrottleCheckResult WillStartRequest() override { return CheckNavigation(); }
+  ThrottleCheckResult WillRedirectRequest() override {
+    return CheckNavigation();
+  }
+  const char* GetNameForLogging() override {
+    return "ViewerNavigationThrottle";
+  }
+
+ private:
+  ThrottleCheckResult CheckNavigation() {
+    const GURL viewer_app_url = GetViewerAppUrlFromCommandLine();
+    if (IsViewerNavigationAllowed(viewer_app_url, navigation_handle()->GetURL()))
+      return PROCEED;
+
+    return BLOCK_REQUEST;
+  }
+};
