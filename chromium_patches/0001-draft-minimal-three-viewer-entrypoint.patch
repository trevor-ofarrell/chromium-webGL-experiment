+void AppendSwitchIfAbsent(base::CommandLine& command_line,
+                          const char switch_name[]) {
+  if (!command_line.HasSwitch(switch_name))
+    command_line.AppendSwitch(switch_name);
+}
+
+void AppendSwitchASCIIIfAbsent(base::CommandLine& command_line,
+                               const char switch_name[],
+                               const std::string& value) {
+  if (!command_line.HasSwitch(switch_name))
+    command_line.AppendSwitchASCII(switch_name, value);
+}
+
+bool ViewerAppUrlIsLocalFile(const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(switches::kViewerAppUrl))
+    return false;
+
+  const base::FilePath viewer_app_path =
+      command_line.GetSwitchValuePath(switches::kViewerAppUrl);
+  if (!viewer_app_path.empty() && viewer_app_path.IsAbsolute())
+    return true;
+
+  const std::string viewer_app_url =
+      command_line.GetSwitchValueASCII(switches::kViewerAppUrl);
+  return viewer_app_url.empty() ||
+         base::StartsWith(viewer_app_url, "file:",
+                          base::CompareCase::INSENSITIVE_ASCII) ||
+         (!base::StartsWith(viewer_app_url, "http:",
+                            base::CompareCase::INSENSITIVE_ASCII) &&
+          !base::StartsWith(viewer_app_url, "https:",
+                            base::CompareCase::INSENSITIVE_ASCII));
+}
+
+void ConfigureViewerTrustedContentSwitches(base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(switches::kViewerAppUrl) ||
+      !command_line.HasSwitch(switches::kViewerTrustedContent))
+    return;
+
+  if (ViewerAppUrlIsLocalFile(command_line))
+    AppendSwitchIfAbsent(command_line, switches::kAllowFileAccessFromFiles);
+
+  if (command_line.HasSwitch(switches::kViewerForceAngleBackend)) {
+    const std::string backend =
+        command_line.GetSwitchValueASCII(switches::kViewerForceAngleBackend);
+    if (!backend.empty() && backend != "default")
+      AppendSwitchASCIIIfAbsent(command_line, switches::kUseANGLE, backend);
+  }
+
+  if (command_line.HasSwitch(switches::kViewerRelaxedWebGLValidation)) {
+    AppendSwitchASCIIIfAbsent(command_line, switches::kUseCmdDecoder,
+                              gl::kCmdDecoderPassthroughName);
+  }
+
+  if (command_line.HasSwitch(switches::kViewerInProcessGpu))
+    AppendSwitchIfAbsent(command_line, switches::kInProcessGPU);
+
+  if (command_line.HasSwitch(switches::kViewerSingleProcess))
+    AppendSwitchIfAbsent(command_line, switches::kSingleProcess);
+
+  if (command_line.HasSwitch(switches::kViewerAggressiveGpu)) {
+    AppendSwitchIfAbsent(command_line, switches::kDisableSoftwareRasterizer);
+    AppendSwitchIfAbsent(command_line, switches::kEnableUnsafeWebGPU);
+    AppendSwitchIfAbsent(command_line, switches::kEnableWebGPUDeveloperFeatures);
+    AppendSwitchIfAbsent(command_line, switches::kForceHighPerformanceGPU);
+    AppendSwitchIfAbsent(command_line,
+                         switches::kNoDelayForDX12VulkanInfoCollection);
+  }
+}
